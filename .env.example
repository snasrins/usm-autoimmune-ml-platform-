# ============================================
# USM Autoimmune ML Platform - Environment Configuration
# INSTRUCTIONS: Copy this file to .env and fill in actual values
# NEVER commit .env to git - only commit .env.example
# ============================================

# === ZeroTier Network Configuration ===
# Get your ZeroTier IP from: ip addr show | grep zt
# Your actual ZeroTier IP: 172.24.50.103
ZEROTIER_IP=172.24.50.103
ZEROTIER_NETWORK_ID=d5e5fb653720782f

# === PostgreSQL Database Configuration ===
POSTGRES_DB=usm_autoimmune_registry
POSTGRES_USER=usm_db_admin
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_HERE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# === JWT Authentication ===
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_32_BYTE_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === PgAdmin Configuration (Optional) ===
PGADMIN_EMAIL=admin@usm.edu.my
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD

# === MinIO Object Storage ===
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_PASSWORD_MIN_8_CHARS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# === CUDA & GPU Configuration ===
CUDA_VISIBLE_DEVICES=0
CUDA_DEVICE_ORDER=PCI_BUS_ID

# === File Upload Configuration ===
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=/data/uploads
PROCESSED_DIR=/data/processed
RAW_DIR=/data/raw

# === Security & Compliance ===
# NMRR Registration Number
NMRR_REGISTRATION_NUMBER=NMRR-XXXXX-XXXXX
# Ethics Clearance Status
ETHICS_CLEARANCE_RECEIVED=false
ETHICS_CLEARANCE_DATE=

# === API Configuration ===
API_V1_PREFIX=/api/v1
PROJECT_NAME=USM Autoimmune ML Platform
PROJECT_VERSION=1.0.0

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=/logs/usm-autoimmune.log

# === Model Serving ===
MODEL_REGISTRY_PATH=/models
DEFAULT_MODEL_VERSION=latest

# === Data Pipeline Configuration ===
DATASET_VERSION_PREFIX=v
ENABLE_DATASET_VERSIONING=true

# === OCR Configuration ===
TESSERACT_LANG=eng+ms
TESSERACT_CMD=/usr/bin/tesseract

# === Email Configuration (for password reset) ===
SMTP_HOST=smtp.usm.edu.my
SMTP_PORT=587
SMTP_USER=noreply@usm.edu.my
SMTP_PASSWORD=CHANGE_THIS_EMAIL_PASSWORD
SMTP_FROM_EMAIL=noreply@usm.edu.my
SMTP_FROM_NAME=USM Autoimmune Platform
